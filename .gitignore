# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data and models -- never commit these. Datasets are large, often
# licence-encumbered, and in this project may contain imagery of real vehicles
# and people. Weights are reproducible from configs plus data.
data/
models/
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.safetensors
!data/.gitkeep
!models/.gitkeep

# Media
*.mp4
*.avi
*.mkv
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg

# Secrets -- an edge node signing key in git would invalidate the entire
# evidence chain.
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
secrets/

# Node
node_modules/
.next/
.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
