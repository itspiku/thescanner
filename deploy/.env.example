# Copy to deploy/.env and fill in. Every value below must be generated:
#
#   docker compose -f deploy/docker-compose.yml run --rm api scanner-api genkey
#
# SCANNER_PLATE_KEY can NEVER change once data exists. Every stored plate is
# indexed by its HMAC, so a new key orphans the entire history.
#
# In anything beyond a single-site pilot these belong in a secrets manager,
# not a file on the server.

POSTGRES_PASSWORD=
MINIO_USER=scanner
MINIO_PASSWORD=

SCANNER_PLATE_KEY=
SCANNER_TOKEN_SECRET=
SCANNER_NODE_TOKEN=
